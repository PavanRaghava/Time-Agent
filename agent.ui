<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Time Agent</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #0a0a0f;
    --surface: #13131a;
    --border: #1e1e2e;
    --accent: #7cffd4;
    --accent2: #ff6b6b;
    --text: #e8e8f0;
    --muted: #555570;
    --user-bg: #1a1a2e;
    --agent-bg: #0d1f1a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    font-family: 'DM Mono', monospace;
    color: var(--text);
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Background grid */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(124,255,212,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(124,255,212,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  header {
    position: relative;
    z-index: 10;
    padding: 18px 28px;
    border-bottom: 1px solid var(--border);
    background: rgba(10,10,15,0.9);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo {
    width: 36px;
    height: 36px;
    background: var(--accent);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 16px;
    color: #000;
    flex-shrink: 0;
  }

  .header-text h1 {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 17px;
    color: var(--text);
    letter-spacing: -0.3px;
  }

  .header-text p {
    font-size: 11px;
    color: var(--muted);
    margin-top: 1px;
  }

  .status-dot {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    color: var(--muted);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  #chat {
    flex: 1;
    overflow-y: auto;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
    z-index: 1;
    scroll-behavior: smooth;
  }

  #chat::-webkit-scrollbar { width: 4px; }
  #chat::-webkit-scrollbar-track { background: transparent; }
  #chat::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

  .msg {
    display: flex;
    flex-direction: column;
    gap: 6px;
    animation: fadeUp 0.3s ease forwards;
    opacity: 0;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .msg.user { align-items: flex-end; }
  .msg.agent { align-items: flex-start; }

  .msg-label {
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0 4px;
  }

  .bubble {
    max-width: 72%;
    padding: 14px 18px;
    border-radius: 14px;
    font-size: 13.5px;
    line-height: 1.65;
    border: 1px solid transparent;
  }

  .msg.user .bubble {
    background: var(--user-bg);
    border-color: rgba(124,255,212,0.15);
    color: var(--text);
    border-bottom-right-radius: 4px;
  }

  .msg.agent .bubble {
    background: var(--agent-bg);
    border-color: rgba(124,255,212,0.1);
    color: var(--text);
    border-bottom-left-radius: 4px;
  }

  .typing-bubble {
    background: var(--agent-bg);
    border: 1px solid rgba(124,255,212,0.1);
    border-radius: 14px;
    border-bottom-left-radius: 4px;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .typing-bubble span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: bounce 1.2s ease-in-out infinite;
  }
  .typing-bubble span:nth-child(2) { animation-delay: 0.2s; }
  .typing-bubble span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
    40% { transform: translateY(-6px); opacity: 1; }
  }

  /* welcome state */
  .welcome {
    margin: auto;
    text-align: center;
    opacity: 0.5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .welcome .icon {
    font-size: 38px;
    margin-bottom: 4px;
  }

  .welcome h2 {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 20px;
  }

  .welcome p {
    font-size: 12px;
    color: var(--muted);
  }

  .suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 6px;
  }

  .suggestion-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: 'DM Mono', monospace;
    font-size: 11.5px;
    padding: 7px 14px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .suggestion-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* input area */
  .input-bar {
    position: relative;
    z-index: 10;
    padding: 16px 24px 20px;
    border-top: 1px solid var(--border);
    background: rgba(10,10,15,0.95);
    backdrop-filter: blur(12px);
  }

  .input-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 10px 14px;
    transition: border-color 0.2s;
  }

  .input-wrap:focus-within {
    border-color: rgba(124,255,212,0.4);
    box-shadow: 0 0 0 3px rgba(124,255,212,0.06);
  }

  #inputField {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-family: 'DM Mono', monospace;
    font-size: 13.5px;
    resize: none;
    height: 22px;
    max-height: 110px;
    overflow-y: auto;
  }

  #inputField::placeholder { color: var(--muted); }

  #sendBtn {
    width: 34px;
    height: 34px;
    background: var(--accent);
    border: none;
    border-radius: 9px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  #sendBtn:hover { background: #5ee8be; transform: scale(1.05); }
  #sendBtn:active { transform: scale(0.96); }
  #sendBtn:disabled { background: var(--border); cursor: not-allowed; transform: none; }

  #sendBtn svg { width: 16px; height: 16px; fill: #000; }

  /* session info */
  .session-info {
    font-size: 10px;
    color: var(--muted);
    text-align: center;
    margin-top: 8px;
    letter-spacing: 0.04em;
  }

  .session-info span { color: rgba(124,255,212,0.5); }

  /* error bubble */
  .error-bubble {
    background: rgba(255,107,107,0.08);
    border: 1px solid rgba(255,107,107,0.2);
    color: var(--accent2);
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 12px;
    max-width: 72%;
  }
</style>
</head>
<body>

<header>
  <div class="logo">T</div>
  <div class="header-text">
    <h1>Time Agent</h1>
    <p>Powered by Google ADK + GPT-4o-mini</p>
  </div>
  <div class="status-dot">
    <div class="dot"></div>
    <span id="statusText">connecting…</span>
  </div>
</header>

<div id="chat">
  <div class="welcome" id="welcome">
    <div class="icon">🕐</div>
    <h2>Ask about time in any city</h2>
    <p>Your agent is ready to help</p>
    <div class="suggestions">
      <button class="suggestion-btn" onclick="sendSuggestion(this)">What time is it in Tokyo?</button>
      <button class="suggestion-btn" onclick="sendSuggestion(this)">Current time in New York</button>
      <button class="suggestion-btn" onclick="sendSuggestion(this)">Time in London now</button>
      <button class="suggestion-btn" onclick="sendSuggestion(this)">What's the time in Dubai?</button>
    </div>
  </div>
</div>

<div class="input-bar">
  <div class="input-wrap">
    <textarea id="inputField" placeholder="Ask about the time in any city…" rows="1"></textarea>
    <button id="sendBtn" onclick="sendMessage()">
      <svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
    </button>
  </div>
  <div class="session-info">Session: <span id="sessionId">—</span></div>
</div>

<script>
  const API = 'http://localhost:8000';
  const APP_NAME = 'my_agent';
  const USER_ID = 'user_' + Math.random().toString(36).slice(2, 8);
  let SESSION_ID = null;
  let busy = false;

  async function init() {
    try {
      const r = await fetch(`${API}/apps/${APP_NAME}/users/${USER_ID}/sessions`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });
      if (r.ok) {
        const data = await r.json();
        SESSION_ID = data.id || data.session_id || data.sessionId || Object.values(data)[0];
        document.getElementById('sessionId').textContent = SESSION_ID?.slice(0, 12) + '…';
        document.getElementById('statusText').textContent = 'online';
      } else {
        document.getElementById('statusText').textContent = 'ready';
        SESSION_ID = 'default';
        document.getElementById('sessionId').textContent = 'default';
      }
    } catch (e) {
      document.getElementById('statusText').textContent = 'ready';
      SESSION_ID = 'default';
    }
  }

  function sendSuggestion(btn) {
    document.getElementById('inputField').value = btn.textContent;
    sendMessage();
  }

  function hideWelcome() {
    const w = document.getElementById('welcome');
    if (w) w.remove();
  }

  function appendMsg(role, text) {
    hideWelcome();
    const chat = document.getElementById('chat');
    const div = document.createElement('div');
    div.className = `msg ${role}`;
    div.innerHTML = `
      <div class="msg-label">${role === 'user' ? 'you' : 'agent'}</div>
      <div class="bubble">${text.replace(/\n/g, '<br>')}</div>
    `;
    chat.appendChild(div);
    chat.scrollTop = chat.scrollHeight;
    return div;
  }

  function showTyping() {
    hideWelcome();
    const chat = document.getElementById('chat');
    const div = document.createElement('div');
    div.className = 'msg agent';
    div.id = 'typing';
    div.innerHTML = `
      <div class="msg-label">agent</div>
      <div class="typing-bubble"><span></span><span></span><span></span></div>
    `;
    chat.appendChild(div);
    chat.scrollTop = chat.scrollHeight;
  }

  function hideTyping() {
    const t = document.getElementById('typing');
    if (t) t.remove();
  }

  async function sendMessage() {
    if (busy) return;
    const field = document.getElementById('inputField');
    const text = field.value.trim();
    if (!text) return;

    busy = true;
    field.value = '';
    field.style.height = '22px';
    document.getElementById('sendBtn').disabled = true;

    appendMsg('user', text);
    showTyping();

    try {
      const url = `${API}/run`;
      const body = {
        app_name: APP_NAME,
        user_id: USER_ID,
        session_id: SESSION_ID,
        new_message: {
          role: 'user',
          parts: [{ text }]
        }
      };

      const r = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });

      hideTyping();

      if (!r.ok) {
        const err = await r.text();
        appendError(`API error ${r.status}: ${err}`);
      } else {
        const events = await r.json();
        let reply = '';
        for (const ev of events) {
          const parts = ev?.content?.parts || [];
          for (const p of parts) {
            if (p.text) reply += p.text;
          }
        }
        if (reply) {
          appendMsg('agent', reply);
        } else {
          appendMsg('agent', '(No response from agent)');
        }
      }
    } catch (e) {
      hideTyping();
      appendError('Could not reach agent server. Is `adk api_server .` still running?');
    }

    busy = false;
    document.getElementById('sendBtn').disabled = false;
    field.focus();
  }

  function appendError(msg) {
    const chat = document.getElementById('chat');
    const div = document.createElement('div');
    div.className = 'msg agent';
    div.innerHTML = `<div class="msg-label">error</div><div class="error-bubble">⚠ ${msg}</div>`;
    chat.appendChild(div);
    chat.scrollTop = chat.scrollHeight;
  }

  // Auto-resize textarea
  document.getElementById('inputField').addEventListener('input', function() {
    this.style.height = '22px';
    this.style.height = Math.min(this.scrollHeight, 110) + 'px';
  });

  // Enter to send, Shift+Enter for newline
  document.getElementById('inputField').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  init();
</script>
</body>
</html>